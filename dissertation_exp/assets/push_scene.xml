<mujoco model="push_scene">
  <compiler angle="radian"/>

  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast"/>

  <asset>
    <texture type="2d" name="floor_tex" builtin="checker"
             rgb1="0.85 0.85 0.85" rgb2="0.65 0.65 0.65" width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="4 4"/>
    <material name="block_mat" rgba="0.2 0.5 0.9 1"/>
    <material name="target_mat" rgba="0.1 0.8 0.2 0.4"/>
    <material name="pusher_mat" rgba="0.9 0.3 0.1 1"/>
  </asset>

  <worldbody>
    <!-- Ground plane -->
    <geom name="floor" type="plane" size="3 3 0.1"
          material="floor_mat" friction="0.5 0.005 0.0001" condim="3"/>

    <!-- Target marker (visual only) -->
    <body name="target_marker" pos="0.4 0.0 0.002">
      <geom name="target_geom" type="cylinder" size="0.06 0.001"
            material="target_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- Block: 2-DOF slide only (no rotation) for numerical stability -->
    <body name="block" pos="0.0 0.0 0.025">
      <joint name="block_x" type="slide" axis="1 0 0" damping="2.0" armature="0.001"/>
      <joint name="block_y" type="slide" axis="0 1 0" damping="2.0" armature="0.001"/>
      <geom name="block_geom" type="box" size="0.025 0.025 0.025"
            material="block_mat" friction="0.5 0.005 0.0001"
            mass="0.15" condim="3"/>
    </body>

    <!-- Pusher sphere -->
    <body name="pusher" pos="-0.08 0.0 0.025">
      <joint name="pusher_x" type="slide" axis="1 0 0" damping="8.0" armature="0.001"/>
      <joint name="pusher_y" type="slide" axis="0 1 0" damping="8.0" armature="0.001"/>
      <geom name="pusher_geom" type="sphere" size="0.018"
            material="pusher_mat" friction="0.5 0.005 0.0001"
            mass="0.3" condim="3"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="push_x" joint="pusher_x" kv="30" gear="1" ctrllimited="true" ctrlrange="-1 1"/>
    <velocity name="push_y" joint="pusher_y" kv="30" gear="1" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>

</mujoco>
